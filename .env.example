# Copy to `.env` and fill in. `.env` is gitignored - keep your API key out of git.

# ---------------------------------------------------------------- PVOutput ---
# Settings -> API Settings on pvoutput.org. Tick "API Access: Enabled".
PVOUTPUT_API_KEY=
# The System Id of the whole array (also on the API Settings page).
PVOUTPUT_SYSTEM_ID=

# Set to true to log what would be uploaded without contacting PVOutput.
# Useful for the first run: credentials are not required in this mode.
PVOUTPUT_DRY_RUN=false

# --------------------------------------------------------------- Behaviour ---
# Your local time zone. PVOutput records readings in local wall-clock time.
TZ=Europe/Copenhagen

# info | debug | warn | error. Use debug while you verify the decoding.
LOG_LEVEL=info

# How often the whole-array power reading is published, in seconds.
# 300 = PVOutput's standard 5-minute interval = 12 requests/hour.
PVOUTPUT_POST_INTERVAL_SECONDS=300

# Power readings are averaged over this trailing window before publishing.
POWER_AVERAGE_WINDOW_SECONDS=300

# Your account's hourly API allowance: 60 for a free account, 300 for a donator.
# The uploader paces itself to stay inside this.
PVOUTPUT_RATE_LIMIT_PER_HOUR=60

# ------------------------------------------------------- Micro-inverters ------
# Optional: publish each micro-inverter's daily energy to its own PVOutput
# system. Each mapped inverter costs one request per cycle, so keep the
# interval x inverter count inside the rate limit above.
PVOUTPUT_MICROINVERTER_MODE=false
PVOUTPUT_MICROINVERTER_INTERVAL_SECONDS=900

# Last 4 hex digits of each inverter serial -> PVOutput system id.
# Either `1a2b=11111,3c4d=22222` or JSON: {"1a2b":"11111","3c4d":"22222"}
# Run with LOG_LEVEL=debug once and the serials the Egate reports appear in
# the log, including any that have no mapping yet.
PVOUTPUT_MICROINVERTER_MAPPING=

# ------------------------------------------------------------- Networking ----
# Ports inside the container. The host-side well-known ports (1020, 9800) are
# mapped onto these in compose.yaml - change both if you change these.
LISTEN_PORTS=11020,19800
LISTEN_ADDRESS=0.0.0.0

# Close a connection that has sent nothing for this long; the Egate reconnects.
SOCKET_IDLE_TIMEOUT_SECONDS=900
MAX_CONNECTIONS=16

HEALTH_ENABLED=true
HEALTH_PORT=8080

# ----------------------------------------------------------------- Relay -----
# Also forward raw frames to Involar's old collector. Involar is bankrupt and
# the endpoint is dead, so leave this off.
INVOLAR_RELAY=false
INVOLAR_SERVER=62.28.182.144
INVOLAR_PORT=1020

# ------------------------------------------------------------ Diagnostics ----
# Append every frame (hex) to /app/data/frames.log. Rotated, unlike v1's
# unbounded log files. Only turn this on while debugging the decoding.
RAW_LOG=false
RAW_LOG_MAX_BYTES=5242880
RAW_LOG_MAX_FILES=3

# Readings that cannot be uploaded within this many hours are discarded.
PVOUTPUT_MAX_QUEUE_AGE_HOURS=24
