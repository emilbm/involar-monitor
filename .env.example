# Copy to `.env` and adjust. Nothing here is secret and nothing is required -
# the defaults run, but you will want to set TZ.

# --------------------------------------------------------------- Behaviour ---
# Your local time zone. Days, weeks and months on the dashboard are bucketed
# in this zone, so "today" means the day you actually lived through.
TZ=Europe/Copenhagen

# info | debug | warn | error. Use debug while you verify the decoding.
LOG_LEVEL=info

# ---------------------------------------------------------------- Storage ---
# Everything lands in one SQLite file. Back up DATA_DIR and you have it all.
DATA_DIR=/app/data
# DB_PATH=/app/data/solar.db

# Raw per-reading samples are pruned past this many days. The hourly and daily
# rollups the long-range charts use are kept forever, so old history stays
# readable at lower resolution. 0 keeps every raw sample.
SAMPLE_RETENTION_DAYS=400

# A gap longer than this between two readings contributes no energy, so an
# outage or the overnight silence cannot invent generation that never happened.
ENERGY_MAX_GAP_SECONDS=900

# -------------------------------------------------------------- Dashboard ---
WEB_ENABLED=true
WEB_PORT=8080
WEB_ADDRESS=0.0.0.0

# The "Now" figure is a mean across this trailing window, which is steadier to
# read than the raw reading (that is shown underneath it).
LIVE_WINDOW_SECONDS=120

# No reading for this long and the dashboard reports the Egate as stale.
LIVE_STALE_AFTER_SECONDS=300

# ------------------------------------------------------- Micro-inverters -----
# Optional display names. Unlabelled inverters still show up, under their
# serial - run with LOG_LEVEL=debug once, or check the dashboard footer, to see
# which serials your Egate reports.
# Either `1a2b=Roof south,3c4d=Garage` or JSON: {"1a2b":"Roof south"}
INVERTER_LABELS=

# ------------------------------------------------------------- Networking ---
# Ports inside the container. The host-side well-known ports (1020, 9800) are
# mapped onto these in compose.yaml - change both if you change these.
LISTEN_PORTS=11020,19800
LISTEN_ADDRESS=0.0.0.0

# Close a connection that has sent nothing for this long; the Egate reconnects.
SOCKET_IDLE_TIMEOUT_SECONDS=900
MAX_CONNECTIONS=16

# ----------------------------------------------------------------- Relay -----
# Also forward raw frames to Involar's old collector. Involar is bankrupt and
# the endpoint is dead, so leave this off.
INVOLAR_RELAY=false
INVOLAR_SERVER=62.28.182.144
INVOLAR_PORT=1020

# --------------------------------------------------------- Error reporting ---
# Sentry-protocol error reporting. Works with GlitchTip, which ingests the same
# envelope format. Leave empty to disable it entirely - nothing is sent and no
# connection is attempted.
#
# GlitchTip shows the DSN under Settings -> Projects -> <project> -> keys.
# A malformed DSN fails at startup rather than silently dropping errors later.
SENTRY_DSN=

SENTRY_ENVIRONMENT=production
# Shown on each event; useful for telling which build produced an error.
SENTRY_RELEASE=
# Defaults to the container hostname.
SENTRY_SERVER_NAME=
# A crash loop could otherwise generate thousands of events a minute.
SENTRY_MAX_EVENTS_PER_MINUTE=30

# ------------------------------------------------------------ Diagnostics ----
# Append every frame (hex) to DATA_DIR/frames.log. Rotated, not unbounded.
# Only turn this on while debugging the decoding.
RAW_LOG=false
RAW_LOG_MAX_BYTES=5242880
RAW_LOG_MAX_FILES=3
